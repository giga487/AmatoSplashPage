@page "/bouncingballs"
@using AmatoFluent.ViewModels
@inject BouncingBallsViewModel ViewModel
@implements IDisposable

<PageTitle>Bouncing Balls con SkiaSharp</PageTitle>

<div class="demo-stage-page">
    <a class="back-to-demos" href="demos">Back to demos</a>
    <div class="bouncing-balls-viewport">
        <SKCanvasView @ref="_canvas" OnPaintSurface="ViewModel.OnPaintSurface" IgnorePixelScaling="false" style="width: 100%; height: 100%; display: block;" />
    </div>
</div>

@code {
    private SKCanvasView? _canvas;

    protected override void OnInitialized()
    {
        ViewModel.OnStateChanged += HandleStateChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ViewModel.Start();
        }
    }

    private void HandleStateChanged()
    {
        _canvas?.Invalidate();
    }

    public void Dispose()
    {
        ViewModel.OnStateChanged -= HandleStateChanged;
        ViewModel.Dispose();
    }
}
