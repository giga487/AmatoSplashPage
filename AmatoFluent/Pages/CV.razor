@page "/cv"
@using AmatoFluent.Models
@inject HttpClient Http

<PageTitle>Curriculum vitae</PageTitle>

@if (cvData == null)
{
    <FluentSpinner aria-label="Loading curriculum vitae" />
}
else
{
    <FluentStack Class="cv-page" Orientation="Orientation.Vertical" VerticalGap="20">
        
        <FluentText Block="true" As="TextTag.H1" Size="TextSize.Size800">Pierluigi Amato</FluentText>
        <FluentText Block="true" As="TextTag.Paragraph" Size="TextSize.Size500">Curriculum Vitae</FluentText>
        <FluentDivider />

        <FluentCard>
            <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">Contact</FluentText>
            <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 15px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Mail())" Color="Color.Default" />
                    <a href="mailto:@cvData.Contact.Email?subject=AskSomethingViaSite" style="color: var(--colorBrandForeground1); text-decoration: none;">@cvData.Contact.Email</a>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="Color.Default" />
                    <a href="@cvData.Contact.LinkedIn" target="_blank" style="color: var(--colorBrandForeground1); text-decoration: none;">LinkedIn Profile</a>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Location())" Color="Color.Default" />
                    <span style="color: var(--colorNeutralForeground1);">@cvData.Contact.Location</span>
                </div>
                <div class="cv-downloads">
                    <FluentAnchorButton Href="https://raw.githubusercontent.com/giga487/AmatoSplashPage/main/AmatoFluent/wwwroot/AmatoCV.pdf" download="amatocv.pdf" Appearance="ButtonAppearance.Primary" Target="LinkTarget.Blank" IconStart="@(new Icons.Regular.Size20.DocumentPdf())">
                        Download PDF
                    </FluentAnchorButton>
                    <FluentAnchorButton Href="https://raw.githubusercontent.com/giga487/AmatoSplashPage/main/cv-data.json" download="cv-data.json" Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.Document())">
                        Download JSON Data
                    </FluentAnchorButton>
                </div>
            </div>
        </FluentCard>

        <FluentCard>
            <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">Who am I</FluentText>
            <div style="margin-top: 10px; line-height: 1.6; color: var(--colorNeutralForeground1);">
                @foreach (var p in cvData.Summary)
                {
                    <p>@((MarkupString)p.Replace("**Currently**", "<strong>Currently</strong>")
                                          .Replace("[GitHub Page](https://giga487.github.io/AmatoSplashPage/)", "<a href=\"https://giga487.github.io/AmatoSplashPage/\">GitHub Page</a>"))</p>
                }
            </div>
        </FluentCard>

        <FluentCard>
            <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">Jobs</FluentText>
            @foreach (var job in cvData.Jobs)
            {
                <div style="margin-top: 15px;">
                    <FluentText Block="true" As="TextTag.H3" Size="TextSize.Size500">@job.Title@(!string.IsNullOrEmpty(job.Company) ? $", {job.Company}" : "")</FluentText>
                    <FluentText Block="true" Size="TextSize.Size300" Color="Color.Default">@job.Date</FluentText>
                    @if (job.Tasks != null && job.Tasks.Count > 0)
                    {
                        <ul style="margin-top: 5px;">
                            @foreach (var task in job.Tasks)
                            {
                                <li>@((MarkupString)task.Replace("[SKIA 2D graphics](https://skia.org/)", "<a href=\"https://skia.org/\" target=\"_blank\">SKIA 2D graphics</a>")
                                                        .Replace("[Halcon](https://www.mvtec.com/products/halcon)", "<a href=\"https://www.mvtec.com/products/halcon\" target=\"_blank\">Halcon</a>")
                                                        .Replace("**GITHUB**", "<strong>GITHUB</strong>"))</li>
                            }
                        </ul>
                    }
                </div>
                @if (job != cvData.Jobs.Last())
                {
                    <FluentDivider Style="margin: 15px 0;" />
                }
            }
        </FluentCard>

        @if (cvData.OpenSourceContributions.Count > 0)
        {
            <FluentCard>
                <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">Open-source contributions</FluentText>
                @foreach (OpenSourceContributionInfo contribution in cvData.OpenSourceContributions)
                {
                    <article style="margin-top: 15px;">
                        <FluentText Block="true" As="TextTag.H3" Size="TextSize.Size500">@contribution.Project</FluentText>
                        <FluentText Block="true" Size="TextSize.Size300">@contribution.Status · @contribution.Date</FluentText>
                        <p style="margin-top: 10px;">
                            <a href="@contribution.Url" target="_blank" rel="noopener noreferrer">@contribution.Title</a>
                        </p>
                        <p>@contribution.Description</p>
                    </article>
                }
            </FluentCard>
        }

        <FluentCard>
            <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">Education</FluentText>
            <div style="margin-top: 10px;">
                @foreach(var edu in cvData.Education)
                {
                    <div style="margin-bottom: 15px;">
                        <FluentText Block="true" As="TextTag.H3" Size="TextSize.Size500">
                            <FluentIcon Value="@(new Icons.Regular.Size20.HatGraduation())" Style="margin-right: 5px;" Color="Color.Default" /> @edu.Title
                        </FluentText>
                        @if (!string.IsNullOrEmpty(edu.Date))
                        {
                            <FluentText Block="true" Size="TextSize.Size300" Color="Color.Default">@edu.Date</FluentText>
                        }
                        @if (!string.IsNullOrEmpty(edu.Description))
                        {
                            <span style="display:block; margin-top:5px;">
                                @((MarkupString)edu.Description.Replace("[here](https://ieeexplore.ieee.org/document/10016730)", "<a href=\"https://ieeexplore.ieee.org/document/10016730\" target=\"_blank\">here</a>"))
                            </span>
                        }
                    </div>
                }
            </div>
        </FluentCard>

        <FluentCard>
            <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">Technical Skills</FluentText>
            <div style="margin-top: 10px; display: flex; flex-wrap: wrap; gap: 15px;">
                @foreach(var skill in cvData.TechnicalSkills)
                {
                    <div style="flex: 1 1 calc(50% - 15px); min-width: 200px;">
                        <FluentText Block="true" As="TextTag.H3" Size="TextSize.Size500">@skill.Category</FluentText>
                        <FluentText Block="true" Size="TextSize.Size300" Color="Color.Default">@skill.Details</FluentText>
                    </div>
                }
            </div>
        </FluentCard>

        <FluentCard>
            <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">University Projects</FluentText>
            <ul style="margin-top: 15px; line-height: 1.6;">
                @foreach(var uprog in cvData.UniversityProjects)
                {
                    <li style="margin-bottom: 10px;">
                        <strong>@uprog.Title</strong><br/>
                        @((MarkupString)uprog.Description.Replace("**railway simulator**", "<b>railway simulator</b>")
                                                         .Replace("[YouTube](https://www.youtube.com/watch?v=wL0Aum5eXEo)", "<a href=\"https://www.youtube.com/watch?v=wL0Aum5eXEo\" target=\"_blank\">YouTube video</a>"))
                    </li>
                }
            </ul>
        </FluentCard>

        <FluentCard>
            <FluentText Block="true" As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Semibold">Personal Projects</FluentText>
            <ul style="margin-top: 15px; line-height: 1.6;">
                @foreach(var proj in cvData.Projects)
                {
                    <li style="margin-bottom: 10px;">
                        <strong>@proj.Title:</strong> 
                        @((MarkupString)proj.Description.Replace("[giga487](https://github.com/giga487)", "<a href=\"https://github.com/giga487\" target=\"_blank\">giga487</a>"))
                        @if (proj.Tasks != null && proj.Tasks.Count > 0)
                        {
                            <ul>
                                @foreach(var task in proj.Tasks)
                                {
                                    <li>@task</li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </FluentCard>
    </FluentStack>
}

@code {
    private CvData? cvData;

    protected override async Task OnInitializedAsync()
    {
        // Load the CV structured Data from JSON Source of truth.
        cvData = await Http.GetFromJsonAsync<CvData>("sample-data/cv-data.json");
    }
}
